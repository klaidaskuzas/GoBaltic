# Environment Variables for GoBaltic Transport
# Copy this file to .env.local and fill in the values

# Database (Optional - uses in-memory if not set)
DATABASE_URL=

# Email Service (SendGrid)
SENDGRID_API_KEY=

# Port Configuration
PORT=3000
HOST=127.0.0.1

# Node Environment
NODE_ENV=development

# Mapbox (if using maps)
MAPBOX_GL_ACCESS_TOKEN=

# OpenAI (if using AI features)
OPENAI_API_KEY=

# Stripe (if using payments)
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=

# Formspree
FORMSPREE_ENDPOINT=https://formspree.io/f/maqrnrnr
